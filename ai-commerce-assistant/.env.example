APP_NAME="AI Commerce Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_commerce_assistant
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# eBay Marketplace Integration
# EBAY_MODE options: mock (non-production only) | sandbox | production
# When APP_ENV=production, EBAY_MODE=mock is blocked and EBAY_CLIENT_ID / EBAY_CLIENT_SECRET are required.
EBAY_MODE=mock
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_TIMEOUT=15
EBAY_RETRY_ATTEMPTS=2
EBAY_RETRY_BACKOFF_MS=500
EBAY_CACHE_TTL_SEARCH=900
EBAY_CACHE_TTL_ITEM=3600

# AI Commerce Intelligence Layer
# AI_PROVIDER options: mock (non-production only) | openai
# When APP_ENV=production, AI_PROVIDER=mock is blocked and a live provider with AI_API_KEY is required.
AI_PROVIDER=mock
AI_PROMPT_VERSION=v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=15
