# Root Git Ignore for AI Commerce Assistant

# Environment files and credentials (CRITICAL)
.env
.env.*
!.env.example
ai-commerce-assistant/.env
ai-commerce-assistant/.env.*
!ai-commerce-assistant/.env.example
*.env

# Dependencies
vendor/
ai-commerce-assistant/vendor/
node_modules/
ai-commerce-assistant/node_modules/

# Storage & Logs
*.log
ai-commerce-assistant/storage/*.key
ai-commerce-assistant/storage/pail
ai-commerce-assistant/storage/logs/*.log
ai-commerce-assistant/public/storage

# Cache & Tests
.phpunit.cache/
ai-commerce-assistant/.phpunit.cache/
.phpunit.result.cache
ai-commerce-assistant/.phpunit.result.cache

# IDEs & System files
.vscode/
.idea/
.DS_Store
Thumbs.db


# Flutter generated build files
**/build/
**/.dart_tool/
**/.flutter-plugins*
**/.pub-cache/
**/.pub/

# Android Signing
key.properties
*.jks
*.keystore
